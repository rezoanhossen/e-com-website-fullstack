# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT
JWT_SECRET=your_jwt_secret_key_here_make_it_very_secure

# PhonePe (UPI Payment Gateway)
# Get these from: https://merchant.phonepe.com/
# For production: Use live credentials
# For testing: Use sandbox credentials
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api.phonepe.com/apis/heroku/pg/v1
CALLBACK_URL=http://localhost:5000/api/payments/callback
